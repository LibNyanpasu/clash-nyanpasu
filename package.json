{
  "name": "@nyanpasu/monorepo",
  "version": "2.0.0",
  "repository": "https://github.com/libnyanpasu/clash-nyanpasu.git",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "run-p tauri:dev",
    "dev:diff": "run-p tauri:diff",
    "build": "tauri build",
    "build:packages": "run-s build:package:*",
    "build:package:interface": "pnpm --filter=@nyanpasu/interface build",
    "build:package:utils": "pnpm --filter=@nyanpasu/utils build",
    "build:release": "run-s build:packages build",
    "build:debug": "tauri build -f verge-dev deadlock-detection -d -c \"{ \\\"tauri\\\" : { \\\"updater\\\": { \\\"active\\\": false } }} \"",
    "build:nightly": "tauri build -f nightly -c ./backend/tauri/tauri.nightly.conf.json",
    "tauri": "tauri",
    "tauri:dev": "tauri dev -c ./backend/tauri/tauri.conf.json",
    "tauri:diff": "tauri dev -f verge-dev deadlock-detection -c ./backend/tauri/tauri.conf.json",
    "tauri:preview": "pnpm prepare:preview && tauri dev -f verge-dev deadlock-detection -c ./backend/tauri/tauri.preview.conf.json",
    "web:dev": "pnpm --filter=@nyanpasu/nyanpasu dev",
    "web:build": "pnpm --filter=@nyanpasu/nyanpasu build",
    "web:serve": "pnpm --filter=@nyanpasu/nyanpasu preview",
    "web:visualize": "pnpm --filter=@nyanpasu/nyanpasu bundle:visualize",
    "typecheck": "run-s lint:ts",
    "lint": "run-s lint:*",
    "lint:prettier": "prettier --check .",
    "lint:oxlint": "oxlint .",
    "lint:deno": "deno fmt --check --config scripts/deno.jsonc scripts && deno check --config scripts/deno.jsonc scripts/*.ts",
    "lint:architecture-ledger": "deno run -A scripts/architecture-ledger.ts --mode=gate",
    "architecture-ledger": "deno run -A scripts/architecture-ledger.ts --mode=report",
    "lint:styles": "stylelint --cache --allow-empty-input \"**/*.{css,scss}\"",
    "lint:ts": "run-s lint:ts:*",
    "lint:ts:interface": "tsc --noEmit --project ./frontend/interface/tsconfig.json",
    "lint:ts:nyanpasu": "tsc --noEmit --project ./frontend/nyanpasu/tsconfig.json",
    "lint:ts:utils": "tsc --noEmit --project ./frontend/utils/tsconfig.json",
    "lint:clippy": "cargo clippy --manifest-path ./backend/Cargo.toml --all-targets --all-features",
    "lint:rustfmt": "cargo fmt --manifest-path ./backend/Cargo.toml --all -- --check",
    "knip": "knip",
    "test": "run-p test:*",
    "test:architecture-ledger": "deno test --config scripts/deno.jsonc -A scripts/architecture-ledger_test.ts",
    "test:proxy-group-delay": "node --test scripts/proxy-group-delay.test.mjs",
    "test:clash-ws": "node --test scripts/clash-ws-state.test.mjs",
    "test:backend": "cargo test --manifest-path ./backend/Cargo.toml --all-features",
    "fmt": "run-p fmt:*",
    "fmt:backend": "cargo fmt --manifest-path ./backend/Cargo.toml --all",
    "fmt:prettier": "prettier --write .",
    "fmt:oxlint": "oxlint --fix .",
    "updater": "deno run -A scripts/updater.ts",
    "updater:nightly": "deno run -A scripts/updater-nightly.ts",
    "publish": "deno run -A scripts/publish.ts",
    "portable": "deno run -A scripts/portable.ts",
    "generate:git-info": "deno run -A scripts/generate-git-info.ts",
    "generate:data-slots": "deno run -A scripts/extract-data-slots.ts",
    "generate:manifest": "run-p generate:manifest:*",
    "generate:manifest:latest-version": "deno run -A scripts/generate-latest-version.ts",
    "prepare": "husky",
    "prepare:nightly": "deno run -A scripts/prepare-nightly.ts",
    "prepare:release": "deno run -A scripts/prepare-release.ts",
    "prepare:preview": "deno run -A scripts/prepare-preview.ts",
    "prepare:check": "deno run -A scripts/check.ts"
  },
  "dependencies": {
    "@prettier/plugin-oxc": "0.2.2",
    "husky": "9.1.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.5",
    "knip": "6.35.1",
    "lint-staged": "17.5.1",
    "npm-run-all2": "9.0.3",
    "oxlint": "1.82.0",
    "postcss": "8.5.28",
    "postcss-html": "2.0.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prettier-plugin-toml": "2.0.6",
    "stylelint": "17.15.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "3.0.0",
    "stylelint-order": "8.1.1",
    "stylelint-scss": "7.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.21.0"
  }
}
